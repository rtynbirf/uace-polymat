{
  "manifest_version": 3,
  "name": "Cookie Vault",
  "version": "3.0.1",
  "minimum_chrome_version": "111",
  "description": "Зашифрованное резервное хранилище cookies: AES-256-GCM + PBKDF2-SHA256. Полностью офлайн, 0 сетевых запросов.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Cookie Vault 3.0.1",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
